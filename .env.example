# DriveTogether Environment Variables
# In DEMO_MODE=true, the entire application works immediately with realistic mock data,
# demo OTP (123456), and demo payment flow without requiring live external services.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Payment Gateway (Razorpay/Cashfree integration placeholder for production)
NEXT_PUBLIC_PAYMENT_GATEWAY=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
